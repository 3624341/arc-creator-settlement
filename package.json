  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:web": "tsx --tsconfig tsconfig.web-test.json --test --test-isolation=none \"web-test/**/*.test.ts\" \"web-test/**/*.test.tsx\"",
